<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net7.0 rather than the newest available: it matches the plugin's .NET Core target
      and builds under a .NET 7, 8, or 9 SDK.
    -->
    <TargetFramework>net7.0</TargetFramework>
    <!-- Compile against net7.0 to match the plugin, but run on whatever newer runtime the
         machine has — a .NET 8/9 SDK does not ship the .NET 7 runtime. -->
    <RollForward>LatestMajor</RollForward>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>RhinoClaude.Tests</RootNamespace>
    <AssemblyName>RhinoClaude.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <!--
    The plugin assembly cannot be referenced directly: RhinoCommon is a compile-only
    reference, so its types are unavailable at test runtime. Instead the RhinoCommon-free
    parts of the agent core are linked in as source. Anything listed here must stay free
    of `using Rhino…` — that constraint is exactly what keeps the protocol layer testable.
  -->
  <ItemGroup>
    <Compile Include="..\RhinoClaude\Agent\AnthropicModels.cs" Link="Linked\AnthropicModels.cs" />
    <Compile Include="..\RhinoClaude\Agent\SseParser.cs" Link="Linked\SseParser.cs" />
    <Compile Include="..\RhinoClaude\Agent\StreamAccumulator.cs" Link="Linked\StreamAccumulator.cs" />
    <Compile Include="..\RhinoClaude\Agent\CostBudget.cs" Link="Linked\CostBudget.cs" />
    <Compile Include="..\RhinoClaude\Agent\PromptCache.cs" Link="Linked\PromptCache.cs" />
    <Compile Include="..\RhinoClaude\Agent\PayloadCaps.cs" Link="Linked\PayloadCaps.cs" />
    <Compile Include="..\RhinoClaude\Agent\ModelCapabilities.cs" Link="Linked\ModelCapabilities.cs" />
    <Compile Include="..\RhinoClaude\Agent\ReviewModels.cs" Link="Linked\ReviewModels.cs" />
    <Compile Include="..\RhinoClaude\Agent\SessionMutationLog.cs" Link="Linked\SessionMutationLog.cs" />
    <Compile Include="..\RhinoClaude\Agent\HistoryCompactor.cs" Link="Linked\HistoryCompactor.cs" />
    <Compile Include="..\RhinoClaude\Agent\ConversationSnapshot.cs" Link="Linked\ConversationSnapshot.cs" />
    <Compile Include="..\RhinoClaude\Agent\UndoScope.cs" Link="Linked\UndoScope.cs" />
    <Compile Include="..\RhinoClaude\Agent\ToolContracts.cs" Link="Linked\ToolContracts.cs" />
    <Compile Include="..\RhinoClaude\Agent\ToolRegistry.cs" Link="Linked\ToolRegistry.cs" />
    <Compile Include="..\RhinoClaude\Agent\JsonlLogger.cs" Link="Linked\JsonlLogger.cs" />
  </ItemGroup>

  <!--
    The semantic layer's core is deliberately Rhino-free for the same reason: vocabulary,
    the layer-convention resolution rule, face/edge classification, selector resolution,
    and every analytical read tool are pure functions over view models. Only the analyzers
    that build those views from Breps need RhinoCommon, and they stay out of this list.
  -->
  <ItemGroup>
    <Compile Include="..\RhinoClaude\Semantic\**\*.cs" LinkBase="Linked\Semantic" />
  </ItemGroup>

</Project>
